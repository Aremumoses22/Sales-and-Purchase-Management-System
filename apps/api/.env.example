# PostgreSQL connection strings (dev and e2e test databases)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/spms?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/spms_test?schema=public"

PORT=4000
# Use 127.0.0.1 in production so only the web app on the same machine can reach the API
HOST=0.0.0.0
# Which proxies may report the client IP (X-Forwarded-For). "loopback, uniquelocal" when the web app
# reaches the API over a private network (Render)
# TRUST_PROXY=loopback
# Interactive API docs at /api/docs (defaults to off when NODE_ENV=production)
# API_DOCS_ENABLED=true

# Generate with: openssl rand -hex 48
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Set to true when served over HTTPS
COOKIE_SECURE=false

# Generate due recurring invoices every hour (set to false to turn the job off)
RECURRING_JOB_ENABLED=true

# Where uploaded files (organization logo, receipts) are stored
UPLOAD_DIR=uploads

# First admin account created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345
