generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── System ───────────────────────────────

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  name               String
  email              String    @unique
  passwordHash       String    @map("password_hash")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  roleId             String    @map("role_id") @db.Uuid
  role               Role      @relation(fields: [roleId], references: [id])
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  contactsCreated          Contact[]                 @relation("ContactCreatedBy")
  itemsCreated             Item[]                    @relation("ItemCreatedBy")
  stockMovementsCreated    StockMovement[]           @relation("StockMovementCreatedBy")
  quotesCreated            Quote[]                   @relation("QuoteCreatedBy")
  invoicesCreated          Invoice[]                 @relation("InvoiceCreatedBy")
  paymentsCreated          PaymentReceived[]         @relation("PaymentCreatedBy")
  refundsCreated           PaymentRefund[]           @relation("RefundCreatedBy")
  creditNotesCreated       CreditNote[]              @relation("CreditNoteCreatedBy")
  creditApplications       CreditApplication[]       @relation("CreditApplicationCreatedBy")
  creditRefundsCreated     CreditNoteRefund[]        @relation("CreditRefundCreatedBy")
  salesReceiptsCreated     SalesReceipt[]            @relation("SalesReceiptCreatedBy")
  recurringInvoicesCreated RecurringInvoiceProfile[] @relation("RecurringInvoiceCreatedBy")
  expensesCreated          Expense[]                 @relation("ExpenseCreatedBy")
  billsCreated             Bill[]                    @relation("BillCreatedBy")
  paymentsMadeCreated      PaymentMade[]             @relation("PaymentMadeCreatedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  /// Every token issued by rotating the same login shares a family; reuse of an old token revokes the family.
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  summary    String
  changes    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Single row (id = 1): this system manages one organization.
model Organization {
  id                   Int      @id @default(1)
  name                 String
  email                String?
  phone                String?
  website              String?
  taxNumber            String?  @map("tax_number")
  addressLine1         String?  @map("address_line1")
  addressLine2         String?  @map("address_line2")
  city                 String?
  state                String?
  postalCode           String?  @map("postal_code")
  country              String?
  currencyCode         String   @default("NGN") @map("currency_code")
  currencySymbol       String   @default("₦") @map("currency_symbol")
  dateFormat           String   @default("dd MMM yyyy") @map("date_format")
  fiscalYearStartMonth Int      @default(1) @map("fiscal_year_start_month")
  timezone             String   @default("Africa/Lagos")
  logoFile             String?  @map("logo_file")
  logoMimeType         String?  @map("logo_mime_type")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("organization")
}

enum DocumentType {
  quote
  invoice
  sales_receipt
  payment_received
  credit_note
  payment_made
}

model NumberSeries {
  documentType DocumentType @id @map("document_type")
  prefix       String
  nextNumber   Int          @map("next_number")
  padding      Int
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("number_series")
}

model PaymentTerm {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  days      Int
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contacts          Contact[]
  invoices          Invoice[]
  recurringInvoices RecurringInvoiceProfile[]

  bills Bill[]

  @@map("payment_terms")
}

model Tax {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  rate      Decimal  @db.Decimal(6, 3)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items                 Item[]
  quoteLines            QuoteLine[]
  invoiceLines          InvoiceLine[]
  creditNoteLines       CreditNoteLine[]
  salesReceiptLines     SalesReceiptLine[]
  recurringInvoiceLines RecurringInvoiceLine[]
  expenses              Expense[]

  billLines BillLine[]

  @@map("taxes")
}

model PaymentMode {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  paymentsReceived PaymentReceived[]
  paymentRefunds   PaymentRefund[]
  creditRefunds    CreditNoteRefund[]
  salesReceipts    SalesReceipt[]
  expenses         Expense[]

  paymentsMade PaymentMade[]

  @@map("payment_modes")
}

model ExpenseCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@map("expense_categories")
}

// ─────────────────────────────── Contacts ───────────────────────────────

enum ContactType {
  customer
  vendor
}

enum ContactKind {
  business
  individual
}

enum AddressKind {
  billing
  shipping
}

model Contact {
  id             String       @id @default(uuid(7)) @db.Uuid
  type           ContactType
  kind           ContactKind  @default(business)
  salutation     String?
  firstName      String?      @map("first_name")
  lastName       String?      @map("last_name")
  companyName    String?      @map("company_name")
  displayName    String       @map("display_name")
  email          String?
  workPhone      String?      @map("work_phone")
  mobile         String?
  website        String?
  taxNumber      String?      @map("tax_number")
  paymentTermId  String?      @map("payment_term_id") @db.Uuid
  paymentTerm    PaymentTerm? @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  openingBalance Decimal      @default(0) @map("opening_balance") @db.Decimal(18, 2)
  notes          String?
  isActive       Boolean      @default(true) @map("is_active")
  createdById    String?      @map("created_by_id") @db.Uuid
  createdBy      User?        @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  addresses         ContactAddress[]
  contactPersons    ContactPerson[]
  quotes            Quote[]
  invoices          Invoice[]
  paymentsReceived  PaymentReceived[]
  creditNotes       CreditNote[]
  salesReceipts     SalesReceipt[]
  recurringInvoices RecurringInvoiceProfile[]
  expenses          Expense[]
  preferredForItems Item[]                    @relation("ItemPreferredVendor")

  bills        Bill[]
  paymentsMade PaymentMade[]

  @@index([type, isActive, displayName])
  @@map("contacts")
}

model ContactAddress {
  id         String      @id @default(uuid(7)) @db.Uuid
  contactId  String      @map("contact_id") @db.Uuid
  contact    Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  kind       AddressKind
  attention  String?
  line1      String?
  line2      String?
  city       String?
  state      String?
  postalCode String?     @map("postal_code")
  country    String?
  phone      String?

  @@unique([contactId, kind])
  @@map("contact_addresses")
}

model ContactPerson {
  id          String  @id @default(uuid(7)) @db.Uuid
  contactId   String  @map("contact_id") @db.Uuid
  contact     Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  position    Int     @default(0)
  salutation  String?
  firstName   String  @map("first_name")
  lastName    String? @map("last_name")
  email       String?
  workPhone   String? @map("work_phone")
  mobile      String?
  designation String?
  isPrimary   Boolean @default(false) @map("is_primary")

  @@index([contactId])
  @@map("contact_persons")
}

// ─────────────────────────────── Items ───────────────────────────────

enum ItemType {
  goods
  service
}

enum StockMovementType {
  opening
  adjustment
  invoice
  sales_receipt
  credit_note
  bill
}

model Item {
  id                  String   @id @default(uuid(7)) @db.Uuid
  type                ItemType
  name                String
  sku                 String?  @unique
  unit                String?
  sellingPrice        Decimal? @map("selling_price") @db.Decimal(18, 2)
  salesDescription    String?  @map("sales_description")
  costPrice           Decimal? @map("cost_price") @db.Decimal(18, 2)
  purchaseDescription String?  @map("purchase_description")
  taxId               String?  @map("tax_id") @db.Uuid
  tax                 Tax?     @relation(fields: [taxId], references: [id], onDelete: SetNull)
  /// Set from Module 10 (Vendors) onwards.
  preferredVendorId   String?  @map("preferred_vendor_id") @db.Uuid
  preferredVendor     Contact? @relation("ItemPreferredVendor", fields: [preferredVendorId], references: [id], onDelete: SetNull)
  trackInventory      Boolean  @default(false) @map("track_inventory")
  reorderLevel        Decimal? @map("reorder_level") @db.Decimal(18, 3)
  isActive            Boolean  @default(true) @map("is_active")
  createdById         String?  @map("created_by_id") @db.Uuid
  createdBy           User?    @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  stockMovements        StockMovement[]
  quoteLines            QuoteLine[]
  invoiceLines          InvoiceLine[]
  creditNoteLines       CreditNoteLine[]
  salesReceiptLines     SalesReceiptLine[]
  recurringInvoiceLines RecurringInvoiceLine[]

  billLines BillLine[]

  @@index([isActive, name])
  @@map("items")
}

model StockMovement {
  id          String            @id @default(uuid(7)) @db.Uuid
  itemId      String            @map("item_id") @db.Uuid
  item        Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  date        DateTime          @db.Date
  type        StockMovementType
  quantity    Decimal           @db.Decimal(18, 3)
  reason      String?
  sourceType  String?           @map("source_type")
  sourceId    String?           @map("source_id") @db.Uuid
  createdById String?           @map("created_by_id") @db.Uuid
  createdBy   User?             @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([itemId, date])
  @@index([sourceType, sourceId])
  @@map("stock_movements")
}

// ─────────────────────────────── Sales: Quotes ───────────────────────────────

enum QuoteStatus {
  draft
  sent
  accepted
  declined
  invoiced
}

enum DiscountType {
  percent
  amount
}

model Quote {
  id              String      @id @default(uuid(7)) @db.Uuid
  number          String      @unique
  customerId      String      @map("customer_id") @db.Uuid
  customer        Contact     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quoteDate       DateTime    @map("quote_date") @db.Date
  expiryDate      DateTime?   @map("expiry_date") @db.Date
  referenceNumber String?     @map("reference_number")
  subject         String?
  status          QuoteStatus @default(draft)
  subtotal        Decimal     @db.Decimal(18, 2)
  discountTotal   Decimal     @map("discount_total") @db.Decimal(18, 2)
  taxTotal        Decimal     @map("tax_total") @db.Decimal(18, 2)
  shippingCharge  Decimal     @default(0) @map("shipping_charge") @db.Decimal(18, 2)
  adjustment      Decimal     @default(0) @db.Decimal(18, 2)
  total           Decimal     @db.Decimal(18, 2)
  customerNotes   String?     @map("customer_notes")
  terms           String?
  sentAt          DateTime?   @map("sent_at")
  acceptedAt      DateTime?   @map("accepted_at")
  declinedAt      DateTime?   @map("declined_at")
  createdById     String?     @map("created_by_id") @db.Uuid
  createdBy       User?       @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  lines   QuoteLine[]
  invoice Invoice?

  @@index([customerId])
  @@index([status, quoteDate])
  @@index([quoteDate])
  @@map("quotes")
}

model QuoteLine {
  id            String       @id @default(uuid(7)) @db.Uuid
  quoteId       String       @map("quote_id") @db.Uuid
  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position      Int
  itemId        String?      @map("item_id") @db.Uuid
  item          Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  quantity      Decimal      @db.Decimal(18, 3)
  unit          String?
  rate          Decimal      @db.Decimal(18, 2)
  discountType  DiscountType @default(percent) @map("discount_type")
  discountValue Decimal      @default(0) @map("discount_value") @db.Decimal(18, 2)
  taxId         String?      @map("tax_id") @db.Uuid
  tax           Tax?         @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxName       String?      @map("tax_name")
  taxRate       Decimal?     @map("tax_rate") @db.Decimal(6, 3)
  amount        Decimal      @db.Decimal(18, 2)
  taxAmount     Decimal      @map("tax_amount") @db.Decimal(18, 2)

  @@index([quoteId])
  @@index([itemId])
  @@map("quote_lines")
}

// ─────────────────────────────── Sales: Invoices ───────────────────────────────

/// Paid, partially paid and overdue are derived from balance_due and due_date.
enum InvoiceStatus {
  draft
  sent
  void
}

model Invoice {
  id                  String                   @id @default(uuid(7)) @db.Uuid
  number              String                   @unique
  customerId          String                   @map("customer_id") @db.Uuid
  customer            Contact                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quoteId             String?                  @unique @map("quote_id") @db.Uuid
  quote               Quote?                   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  invoiceDate         DateTime                 @map("invoice_date") @db.Date
  dueDate             DateTime                 @map("due_date") @db.Date
  paymentTermId       String?                  @map("payment_term_id") @db.Uuid
  paymentTerm         PaymentTerm?             @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  orderNumber         String?                  @map("order_number")
  subject             String?
  status              InvoiceStatus            @default(draft)
  subtotal            Decimal                  @db.Decimal(18, 2)
  discountTotal       Decimal                  @map("discount_total") @db.Decimal(18, 2)
  taxTotal            Decimal                  @map("tax_total") @db.Decimal(18, 2)
  shippingCharge      Decimal                  @default(0) @map("shipping_charge") @db.Decimal(18, 2)
  adjustment          Decimal                  @default(0) @db.Decimal(18, 2)
  total               Decimal                  @db.Decimal(18, 2)
  /// Payments and credits applied so far.
  amountPaid          Decimal                  @default(0) @map("amount_paid") @db.Decimal(18, 2)
  balanceDue          Decimal                  @map("balance_due") @db.Decimal(18, 2)
  customerNotes       String?                  @map("customer_notes")
  terms               String?
  sentAt              DateTime?                @map("sent_at")
  voidedAt            DateTime?                @map("voided_at")
  voidReason          String?                  @map("void_reason")
  /// Set when a recurring profile generated this invoice; the period makes generation idempotent.
  recurringProfileId  String?                  @map("recurring_profile_id") @db.Uuid
  recurringProfile    RecurringInvoiceProfile? @relation(fields: [recurringProfileId], references: [id], onDelete: SetNull)
  recurringPeriodDate DateTime?                @map("recurring_period_date") @db.Date
  createdById         String?                  @map("created_by_id") @db.Uuid
  createdBy           User?                    @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  lines              InvoiceLine[]
  allocations        PaymentAllocation[]
  creditApplications CreditApplication[]
  /// Credit notes raised against this invoice.
  creditNotes        CreditNote[]

  @@unique([recurringProfileId, recurringPeriodDate])
  @@index([customerId])
  @@index([status, dueDate])
  @@index([invoiceDate])
  @@map("invoices")
}

model InvoiceLine {
  id            String       @id @default(uuid(7)) @db.Uuid
  invoiceId     String       @map("invoice_id") @db.Uuid
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position      Int
  itemId        String?      @map("item_id") @db.Uuid
  item          Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  quantity      Decimal      @db.Decimal(18, 3)
  unit          String?
  rate          Decimal      @db.Decimal(18, 2)
  discountType  DiscountType @default(percent) @map("discount_type")
  discountValue Decimal      @default(0) @map("discount_value") @db.Decimal(18, 2)
  taxId         String?      @map("tax_id") @db.Uuid
  tax           Tax?         @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxName       String?      @map("tax_name")
  taxRate       Decimal?     @map("tax_rate") @db.Decimal(6, 3)
  amount        Decimal      @db.Decimal(18, 2)
  taxAmount     Decimal      @map("tax_amount") @db.Decimal(18, 2)

  @@index([invoiceId])
  @@index([itemId])
  @@map("invoice_lines")
}

// ─────────────────────────────── Sales: Payments received ───────────────────────────────

model PaymentReceived {
  id              String       @id @default(uuid(7)) @db.Uuid
  number          String       @unique
  customerId      String       @map("customer_id") @db.Uuid
  customer        Contact      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentDate     DateTime     @map("payment_date") @db.Date
  amount          Decimal      @db.Decimal(18, 2)
  bankCharges     Decimal      @default(0) @map("bank_charges") @db.Decimal(18, 2)
  paymentModeId   String?      @map("payment_mode_id") @db.Uuid
  paymentMode     PaymentMode? @relation(fields: [paymentModeId], references: [id], onDelete: SetNull)
  referenceNumber String?      @map("reference_number")
  notes           String?
  /// Sum of allocations; the unused amount is amount - applied - refunded.
  amountApplied   Decimal      @default(0) @map("amount_applied") @db.Decimal(18, 2)
  amountRefunded  Decimal      @default(0) @map("amount_refunded") @db.Decimal(18, 2)
  createdById     String?      @map("created_by_id") @db.Uuid
  createdBy       User?        @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  allocations PaymentAllocation[]
  refunds     PaymentRefund[]

  @@index([customerId])
  @@index([paymentDate])
  @@map("payments_received")
}

/// How much of a payment went to one invoice.
model PaymentAllocation {
  id        String          @id @default(uuid(7)) @db.Uuid
  paymentId String          @map("payment_id") @db.Uuid
  payment   PaymentReceived @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String          @map("invoice_id") @db.Uuid
  invoice   Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal         @db.Decimal(18, 2)
  createdAt DateTime        @default(now()) @map("created_at")

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model PaymentRefund {
  id              String          @id @default(uuid(7)) @db.Uuid
  paymentId       String          @map("payment_id") @db.Uuid
  payment         PaymentReceived @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  refundDate      DateTime        @map("refund_date") @db.Date
  amount          Decimal         @db.Decimal(18, 2)
  paymentModeId   String?         @map("payment_mode_id") @db.Uuid
  paymentMode     PaymentMode?    @relation(fields: [paymentModeId], references: [id], onDelete: SetNull)
  referenceNumber String?         @map("reference_number")
  notes           String?
  createdById     String?         @map("created_by_id") @db.Uuid
  createdBy       User?           @relation("RefundCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([paymentId])
  @@map("payment_refunds")
}

// ─────────────────────────────── Sales: Credit notes ───────────────────────────────

/// Stored lifecycle. "Closed" is derived: an open credit note with no balance left.
enum CreditNoteStatus {
  draft
  open
  void
}

model CreditNote {
  id              String           @id @default(uuid(7)) @db.Uuid
  number          String           @unique
  customerId      String           @map("customer_id") @db.Uuid
  customer        Contact          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// The invoice this credit was raised against, for reference.
  invoiceId       String?          @map("invoice_id") @db.Uuid
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  creditNoteDate  DateTime         @map("credit_note_date") @db.Date
  referenceNumber String?          @map("reference_number")
  reason          String?
  status          CreditNoteStatus @default(draft)
  /// Goods on the credit note come back into stock while it is open.
  returnToStock   Boolean          @default(false) @map("return_to_stock")
  subtotal        Decimal          @db.Decimal(18, 2)
  discountTotal   Decimal          @map("discount_total") @db.Decimal(18, 2)
  taxTotal        Decimal          @map("tax_total") @db.Decimal(18, 2)
  shippingCharge  Decimal          @default(0) @map("shipping_charge") @db.Decimal(18, 2)
  adjustment      Decimal          @default(0) @db.Decimal(18, 2)
  total           Decimal          @db.Decimal(18, 2)
  /// Applied to invoices and refunded; the balance is total - applied - refunded.
  amountApplied   Decimal          @default(0) @map("amount_applied") @db.Decimal(18, 2)
  amountRefunded  Decimal          @default(0) @map("amount_refunded") @db.Decimal(18, 2)
  balance         Decimal          @db.Decimal(18, 2)
  customerNotes   String?          @map("customer_notes")
  terms           String?
  openedAt        DateTime?        @map("opened_at")
  voidedAt        DateTime?        @map("voided_at")
  voidReason      String?          @map("void_reason")
  createdById     String?          @map("created_by_id") @db.Uuid
  createdBy       User?            @relation("CreditNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  lines        CreditNoteLine[]
  applications CreditApplication[]
  refunds      CreditNoteRefund[]

  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
  @@index([creditNoteDate])
  @@map("credit_notes")
}

model CreditNoteLine {
  id            String       @id @default(uuid(7)) @db.Uuid
  creditNoteId  String       @map("credit_note_id") @db.Uuid
  creditNote    CreditNote   @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  position      Int
  itemId        String?      @map("item_id") @db.Uuid
  item          Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  quantity      Decimal      @db.Decimal(18, 3)
  unit          String?
  rate          Decimal      @db.Decimal(18, 2)
  discountType  DiscountType @default(percent) @map("discount_type")
  discountValue Decimal      @default(0) @map("discount_value") @db.Decimal(18, 2)
  taxId         String?      @map("tax_id") @db.Uuid
  tax           Tax?         @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxName       String?      @map("tax_name")
  taxRate       Decimal?     @map("tax_rate") @db.Decimal(6, 3)
  amount        Decimal      @db.Decimal(18, 2)
  taxAmount     Decimal      @map("tax_amount") @db.Decimal(18, 2)

  @@index([creditNoteId])
  @@index([itemId])
  @@map("credit_note_lines")
}

/// How much of a credit note went to one invoice.
model CreditApplication {
  id           String     @id @default(uuid(7)) @db.Uuid
  creditNoteId String     @map("credit_note_id") @db.Uuid
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceId    String     @map("invoice_id") @db.Uuid
  invoice      Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount       Decimal    @db.Decimal(18, 2)
  appliedDate  DateTime   @map("applied_date") @db.Date
  createdById  String?    @map("created_by_id") @db.Uuid
  createdBy    User?      @relation("CreditApplicationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([creditNoteId, invoiceId])
  @@index([invoiceId])
  @@map("credit_applications")
}

model CreditNoteRefund {
  id              String       @id @default(uuid(7)) @db.Uuid
  creditNoteId    String       @map("credit_note_id") @db.Uuid
  creditNote      CreditNote   @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  refundDate      DateTime     @map("refund_date") @db.Date
  amount          Decimal      @db.Decimal(18, 2)
  paymentModeId   String?      @map("payment_mode_id") @db.Uuid
  paymentMode     PaymentMode? @relation(fields: [paymentModeId], references: [id], onDelete: SetNull)
  referenceNumber String?      @map("reference_number")
  notes           String?
  createdById     String?      @map("created_by_id") @db.Uuid
  createdBy       User?        @relation("CreditRefundCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([creditNoteId])
  @@map("credit_note_refunds")
}

// ─────────────────────────────── Sales: Sales receipts ───────────────────────────────

/// A sale paid on the spot. Completed receipts take stock; none of them are ever owed.
enum SalesReceiptStatus {
  draft
  completed
  void
}

model SalesReceipt {
  id              String             @id @default(uuid(7)) @db.Uuid
  number          String             @unique
  customerId      String             @map("customer_id") @db.Uuid
  customer        Contact            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  receiptDate     DateTime           @map("receipt_date") @db.Date
  paymentModeId   String?            @map("payment_mode_id") @db.Uuid
  paymentMode     PaymentMode?       @relation(fields: [paymentModeId], references: [id], onDelete: SetNull)
  referenceNumber String?            @map("reference_number")
  status          SalesReceiptStatus @default(draft)
  subtotal        Decimal            @db.Decimal(18, 2)
  discountTotal   Decimal            @map("discount_total") @db.Decimal(18, 2)
  taxTotal        Decimal            @map("tax_total") @db.Decimal(18, 2)
  shippingCharge  Decimal            @default(0) @map("shipping_charge") @db.Decimal(18, 2)
  adjustment      Decimal            @default(0) @db.Decimal(18, 2)
  total           Decimal            @db.Decimal(18, 2)
  customerNotes   String?            @map("customer_notes")
  terms           String?
  completedAt     DateTime?          @map("completed_at")
  voidedAt        DateTime?          @map("voided_at")
  voidReason      String?            @map("void_reason")
  createdById     String?            @map("created_by_id") @db.Uuid
  createdBy       User?              @relation("SalesReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  lines SalesReceiptLine[]

  @@index([customerId])
  @@index([status])
  @@index([receiptDate])
  @@map("sales_receipts")
}

model SalesReceiptLine {
  id             String       @id @default(uuid(7)) @db.Uuid
  salesReceiptId String       @map("sales_receipt_id") @db.Uuid
  salesReceipt   SalesReceipt @relation(fields: [salesReceiptId], references: [id], onDelete: Cascade)
  position       Int
  itemId         String?      @map("item_id") @db.Uuid
  item           Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  quantity       Decimal      @db.Decimal(18, 3)
  unit           String?
  rate           Decimal      @db.Decimal(18, 2)
  discountType   DiscountType @default(percent) @map("discount_type")
  discountValue  Decimal      @default(0) @map("discount_value") @db.Decimal(18, 2)
  taxId          String?      @map("tax_id") @db.Uuid
  tax            Tax?         @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxName        String?      @map("tax_name")
  taxRate        Decimal?     @map("tax_rate") @db.Decimal(6, 3)
  amount         Decimal      @db.Decimal(18, 2)
  taxAmount      Decimal      @map("tax_amount") @db.Decimal(18, 2)

  @@index([salesReceiptId])
  @@index([itemId])
  @@map("sales_receipt_lines")
}

// ─────────────────────────────── Sales: Recurring invoices ───────────────────────────────

enum RecurrenceUnit {
  day
  week
  month
  year
}

/// Stored lifecycle. "Expired" is derived: an active profile whose next run is past its end date.
enum RecurringProfileStatus {
  active
  stopped
}

enum RecurringCreateAs {
  draft
  sent
}

model RecurringInvoiceProfile {
  id             String                 @id @default(uuid(7)) @db.Uuid
  name           String
  customerId     String                 @map("customer_id") @db.Uuid
  customer       Contact                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  repeatEvery    Int                    @default(1) @map("repeat_every")
  repeatUnit     RecurrenceUnit         @map("repeat_unit")
  startDate      DateTime               @map("start_date") @db.Date
  /// Null when the profile never expires.
  endDate        DateTime?              @map("end_date") @db.Date
  paymentTermId  String?                @map("payment_term_id") @db.Uuid
  paymentTerm    PaymentTerm?           @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  createAs       RecurringCreateAs      @default(draft) @map("create_as")
  status         RecurringProfileStatus @default(active)
  /// Occurrence number of the next period (0 = the start date); dates are always derived from
  /// the start date so month ends never drift (31 Jan → 28/29 Feb → 31 Mar).
  nextIndex      Int                    @default(0) @map("next_index")
  nextRunDate    DateTime               @map("next_run_date") @db.Date
  lastRunAt      DateTime?              @map("last_run_at")
  lastError      String?                @map("last_error")
  orderNumber    String?                @map("order_number")
  subject        String?
  subtotal       Decimal                @db.Decimal(18, 2)
  discountTotal  Decimal                @map("discount_total") @db.Decimal(18, 2)
  taxTotal       Decimal                @map("tax_total") @db.Decimal(18, 2)
  shippingCharge Decimal                @default(0) @map("shipping_charge") @db.Decimal(18, 2)
  adjustment     Decimal                @default(0) @db.Decimal(18, 2)
  total          Decimal                @db.Decimal(18, 2)
  customerNotes  String?                @map("customer_notes")
  terms          String?
  createdById    String?                @map("created_by_id") @db.Uuid
  createdBy      User?                  @relation("RecurringInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  lines    RecurringInvoiceLine[]
  invoices Invoice[]

  @@index([customerId])
  @@index([status, nextRunDate])
  @@map("recurring_invoice_profiles")
}

model RecurringInvoiceLine {
  id            String                  @id @default(uuid(7)) @db.Uuid
  profileId     String                  @map("profile_id") @db.Uuid
  profile       RecurringInvoiceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  position      Int
  itemId        String?                 @map("item_id") @db.Uuid
  item          Item?                   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  quantity      Decimal                 @db.Decimal(18, 3)
  unit          String?
  rate          Decimal                 @db.Decimal(18, 2)
  discountType  DiscountType            @default(percent) @map("discount_type")
  discountValue Decimal                 @default(0) @map("discount_value") @db.Decimal(18, 2)
  taxId         String?                 @map("tax_id") @db.Uuid
  tax           Tax?                    @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxName       String?                 @map("tax_name")
  taxRate       Decimal?                @map("tax_rate") @db.Decimal(6, 3)
  amount        Decimal                 @db.Decimal(18, 2)
  taxAmount     Decimal                 @map("tax_amount") @db.Decimal(18, 2)

  @@index([profileId])
  @@index([itemId])
  @@map("recurring_invoice_lines")
}

// ─────────────────────────────── Purchases: Expenses ───────────────────────────────

/// Money already spent. The amount entered may include tax; subtotal, tax and total are stored.
model Expense {
  id                   String          @id @default(uuid(7)) @db.Uuid
  expenseDate          DateTime        @map("expense_date") @db.Date
  categoryId           String          @map("category_id") @db.Uuid
  category             ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendorId             String?         @map("vendor_id") @db.Uuid
  vendor               Contact?        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  /// "Paid through".
  paymentModeId        String?         @map("payment_mode_id") @db.Uuid
  paymentMode          PaymentMode?    @relation(fields: [paymentModeId], references: [id], onDelete: Restrict)
  referenceNumber      String?         @map("reference_number")
  notes                String?
  amount               Decimal         @db.Decimal(18, 2)
  amountIsTaxInclusive Boolean         @default(false) @map("amount_is_tax_inclusive")
  taxId                String?         @map("tax_id") @db.Uuid
  tax                  Tax?            @relation(fields: [taxId], references: [id], onDelete: Restrict)
  taxName              String?         @map("tax_name")
  taxRate              Decimal?        @map("tax_rate") @db.Decimal(6, 3)
  subtotal             Decimal         @db.Decimal(18, 2)
  taxAmount            Decimal         @map("tax_amount") @db.Decimal(18, 2)
  total                Decimal         @db.Decimal(18, 2)
  receiptFile          String?         @map("receipt_file")
  receiptName          String?         @map("receipt_name")
  receiptMimeType      String?         @map("receipt_mime_type")
  receiptSize          Int?            @map("receipt_size")
  createdById          String?         @map("created_by_id") @db.Uuid
  createdBy            User?           @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@index([expenseDate])
  @@index([categoryId])
  @@index([vendorId])
  @@index([paymentModeId])
  @@map("expenses")
}

// ─────────────────────────────── Purchases: Bills and payments made ───────────────────────────────

/// Stored lifecycle. Paid, partially paid and overdue are derived from the balance and due date.
enum BillStatus {
  draft
  open
  void
}

/// What the business owes a vendor. The number is the vendor's own invoice number.
model Bill {
  id             String       @id @default(uuid(7)) @db.Uuid
  billNumber     String       @map("bill_number")
  vendorId       String       @map("vendor_id") @db.Uuid
  vendor         Contact      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderNumber    String?      @map("order_number")
  billDate       DateTime     @map("bill_date") @db.Date
  dueDate        DateTime     @map("due_date") @db.Date
  paymentTermId  String?      @map("payment_term_id") @db.Uuid
  paymentTerm    PaymentTerm? @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  status         BillStatus   @default(draft)
  subtotal       Decimal      @db.Decimal(18, 2)
  discountTotal  Decimal      @map("discount_total") @db.Decimal(18, 2)
  taxTotal       Decimal      @map("tax_total") @db.Decimal(18, 2)
  shippingCharge Decimal      @default(0) @map("shipping_charge") @db.Decimal(18, 2)
  adjustment     Decimal      @default(0) @db.Decimal(18, 2)
  total          Decimal      @db.Decimal(18, 2)
  amountPaid     Decimal      @default(0) @map("amount_paid") @db.Decimal(18, 2)
  balanceDue     Decimal      @map("balance_due") @db.Decimal(18, 2)
  notes          String?
  terms          String?
  openedAt       DateTime?    @map("opened_at")
  voidedAt       DateTime?    @map("voided_at")
  voidReason     String?      @map("void_reason")
  createdById    String?      @map("created_by_id") @db.Uuid
  createdBy      User?        @relation("BillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  lines       BillLine[]
  allocations BillPaymentAllocation[]

  @@unique([vendorId, billNumber])
  @@index([status, dueDate])
  @@index([billDate])
  @@map("bills")
}

model BillLine {
  id            String       @id @default(uuid(7)) @db.Uuid
  billId        String       @map("bill_id") @db.Uuid
  bill          Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  position      Int
  itemId        String?      @map("item_id") @db.Uuid
  item          Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  quantity      Decimal      @db.Decimal(18, 3)
  unit          String?
  rate          Decimal      @db.Decimal(18, 2)
  discountType  DiscountType @default(percent) @map("discount_type")
  discountValue Decimal      @default(0) @map("discount_value") @db.Decimal(18, 2)
  taxId         String?      @map("tax_id") @db.Uuid
  tax           Tax?         @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxName       String?      @map("tax_name")
  taxRate       Decimal?     @map("tax_rate") @db.Decimal(6, 3)
  amount        Decimal      @db.Decimal(18, 2)
  taxAmount     Decimal      @map("tax_amount") @db.Decimal(18, 2)

  @@index([billId])
  @@index([itemId])
  @@map("bill_lines")
}

model PaymentMade {
  id              String       @id @default(uuid(7)) @db.Uuid
  number          String       @unique
  vendorId        String       @map("vendor_id") @db.Uuid
  vendor          Contact      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  paymentDate     DateTime     @map("payment_date") @db.Date
  amount          Decimal      @db.Decimal(18, 2)
  paymentModeId   String?      @map("payment_mode_id") @db.Uuid
  paymentMode     PaymentMode? @relation(fields: [paymentModeId], references: [id], onDelete: SetNull)
  referenceNumber String?      @map("reference_number")
  notes           String?
  /// Sum of allocations; the unused amount is amount - applied.
  amountApplied   Decimal      @default(0) @map("amount_applied") @db.Decimal(18, 2)
  createdById     String?      @map("created_by_id") @db.Uuid
  createdBy       User?        @relation("PaymentMadeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  allocations BillPaymentAllocation[]

  @@index([vendorId])
  @@index([paymentDate])
  @@map("payments_made")
}

model BillPaymentAllocation {
  id        String      @id @default(uuid(7)) @db.Uuid
  paymentId String      @map("payment_id") @db.Uuid
  payment   PaymentMade @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  billId    String      @map("bill_id") @db.Uuid
  bill      Bill        @relation(fields: [billId], references: [id], onDelete: Restrict)
  amount    Decimal     @db.Decimal(18, 2)
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([paymentId, billId])
  @@index([billId])
  @@map("bill_payment_allocations")
}
